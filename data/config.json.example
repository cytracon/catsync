{
  "sync_root": "~/Google Drive",
  "client_secret_path": "~/.config/catsyncd/client_secret.json",
  "token_path": "~/.config/catsyncd/token.json",
  "db_path": "~/.local/state/catsyncd/state.db",
  "poll_interval": 60,
  "allow_writes": false,
  "allow_deletes": false,
  "dry_run": true,
  "include_shared_drives": false,
  "hash_limit_bytes": 67108864,
  "launch_daemon_at_login": true,
  "launch_tray_at_login": true,
  "desktop_notifications": true,
  "conflict_policy": "prefer_newer",
  "google_docs_mode": "placeholder",
  "proxy_mode": "system",
  "proxy_host": "",
  "proxy_port": 0,
  "upload_limit_kbps": 0,
  "download_limit_kbps": 0,
  "ignore_patterns": ["*.tmp", "*.temp", ".DS_Store", "__pycache__", "node_modules"],
  "selective_sync_paths": [],
  "excluded_sync_paths": [],
  "sync_symlinks": false,
  "daemon_max_actions": 100
}
